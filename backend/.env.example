# Copiar a backend/.env y ajustar. backend/.env no se versiona.
# Solo hace falta para correr el backend fuera de Docker (npm run dev / npm run seed).

PORT=8080

# Dentro de Docker, Mongo se alcanza por el nombre de su servicio:
MONGO_URI=mongodb://root:changeme@mongo:27017/?authSource=admin
# Fuera de Docker (backend en el host, Mongo en su contenedor), usar en cambio:
# MONGO_URI=mongodb://root:changeme@localhost:27017/?authSource=admin

# Costo del hash de contraseñas (bcrypt), entre 4 y 15.
BCRYPT_ROUNDS=10

# Vigencia en minutos e intentos máximos del código de verificación.
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5

# Origen exacto del frontend, para el CORS de las rutas de negocio.
FRONTEND_ORIGIN=http://localhost:5173

# Correo del código de verificación. Sin SMTP_HOST, el código se imprime en consola.
# SMTP_HOST=smtp-relay.sendinblue.com
# SMTP_PORT=587
# SMTP_USER=xxxx@smtp-brevo.com
# SMTP_PASSWORD=
# SMTP_FROM=contratosblockchain@gmail.com

# Buzón real de los usuarios de prueba (npm run seed): crea buzon+empleado@,
# buzon+empleado2@, buzon+verificador@ y buzon+admin@. Vacío = correos @empresa.com.
# SEED_EMAIL=contratosblockchain@gmail.com

# Obligatorio: el backend no arranca sin él. Generar uno propio, por ejemplo
# con `openssl rand -hex 32`.
JWT_SECRET=cambiar-por-un-secreto-real-y-largo
JWT_EXPIRES_MINUTES=60

# Cierre de sesión por inactividad (RNF-07); se aplica antes si vence primero.
SESSION_INACTIVITY_MINUTES=15

# Bloqueo temporal de la cuenta tras intentos fallidos consecutivos (RF-054).
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Fabric: los valores por defecto sirven dentro de Docker. Fuera de Docker, apuntar
# al peer publicado en el host y al material criptográfico de la red:
# FABRIC_PEER_ENDPOINT=localhost:7051
# FABRIC_CRYPTO_PATH=../docker/fabric-samples/test-network/organizations/peerOrganizations/org1.example.com
# FABRIC_CHAINCODE_NAME=contracts
