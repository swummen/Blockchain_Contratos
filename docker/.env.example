# Copiar a docker/.env y ajustar (docker/.env no se versiona). Guía: INSTALACION.md §5.

# --- MongoDB ---
MONGO_ROOT_USER=root
# En un servidor público: openssl rand -hex 24 (antes del primer up.sh: Mongo
# fija la clave al crear su volumen y después ya no la cambia).
MONGO_ROOT_PASSWORD=changeme
MONGO_PORT=27017

# --- Backend ---
# Puerto publicado en el host; dentro de Docker el backend siempre usa el 8080.
BACKEND_PORT=8080

# Valor de desarrollo para que up.sh funcione sin pasos extra. En un servidor
# público: openssl rand -hex 32 (up.sh se niega a publicar con el de ejemplo).
JWT_SECRET=contratos-dev-secret-cambiar-en-produccion

# --- Correo del código de verificación (Brevo) ---
# Vacío: el código se imprime en `docker logs backend`.
# Datos en Brevo: ⚙️ → SMTP & API → pestaña SMTP. SMTP_USER es el login
# xxxx@smtp-brevo.com (no un correo real); SMTP_PASSWORD es la clave SMTP;
# SMTP_FROM debe ser un remitente verificado en Brevo.
# Usar smtp-relay.sendinblue.com: con smtp-relay.brevo.com, desde Colombia el
# servidor presenta un certificado de *.sendinblue.com y la conexión TLS falla.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Usuarios de prueba (los crea up.sh) ---
# Con SEED_EMAIL=buzon@gmail.com se crean buzon+empleado@, buzon+empleado2@,
# buzon+verificador@ y buzon+admin@gmail.com, todos en el mismo buzón.
# Vacío: correos ficticios @empresa.com (el código solo se ve en los logs).
SEED_EMAIL=

# --- Frontend ---
# /api: el nginx del frontend la reenvía al backend (mismo origen, sin CORS). Se
# fija al compilar: si cambia, reconstruir con `docker compose build frontend`.
FRONTEND_PORT=5173
VITE_API_URL=/api

# --- Servidor público (Azure). Guía: DESPLIEGUE-AZURE.md ---
# Vacío en el PC local. En la VM: el DNS de la IP pública, por ejemplo
# trazadoc.eastus.cloudapp.azure.com. Con valor, up.sh y start.sh encienden
# Caddy (HTTPS automático en 80/443).
PUBLIC_DOMAIN=
# Solo para npm run dev contra este backend; en Docker no hace falta.
FRONTEND_ORIGIN=
