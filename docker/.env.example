# Copiar a docker/.env y ajustar. docker/.env nunca se versiona (.gitignore).

# --- Mongo (T3) ---
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=changeme
MONGO_PORT=27017

# --- Backend (T4) ---
# Puerto publicado en el host; adentro de fabric_test el backend siempre
# escucha en 8080. MONGO_URI se arma solo en compose.app.yml a partir de
# MONGO_ROOT_USER/MONGO_ROOT_PASSWORD de arriba.
BACKEND_PORT=8080

# --- Frontend (T6) ---
# Puerto publicado en el host (nginx sirve el build de Vite en el puerto 80
# adentro del contenedor). VITE_API_URL es la URL que usa el NAVEGADOR (corre
# en el host), por eso es localhost:8080 y no backend:8080 — Vite la bakea en
# el bundle en tiempo de build, así que un cambio acá requiere reconstruir la
# imagen (docker compose build frontend), no solo reiniciar el contenedor.
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:8080
