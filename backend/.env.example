# Copiar a backend/.env y ajustar. backend/.env nunca se versiona (.gitignore).

PORT=8080

# Dentro de docker/compose.app.yml, el backend alcanza a Mongo por su nombre
# de servicio en la red fabric_test:
MONGO_URI=mongodb://root:changeme@mongo:27017/?authSource=admin

# Si corrés `npm run dev` fuera de Docker (backend en el host, Mongo en el
# contenedor de T3 con el puerto publicado en 127.0.0.1), usa en cambio:
# MONGO_URI=mongodb://root:changeme@localhost:27017/?authSource=admin

# Identity (Sprint 1, T1): costo del hash de contraseñas (bcryptjs). Entero
# entre 4 y 15; 10 es un default razonable para un sistema interno.
BCRYPT_ROUNDS=10

# Identity (Sprint 1, T2): expiración/reintentos del OTP (decisión D2 del
# plan — sin valor fijado en el SRS, se adoptan estos defaults).
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5

# Identity (Sprint 1, T2): origen exacto del frontend para el CORS de /auth
# (a diferencia de /health y /fabric, que usan "*" por ser solo diagnóstico).
FRONTEND_ORIGIN=http://localhost:5173

# Identity (Sprint 1, T2): SMTP para el envío del OTP por correo. Si
# SMTP_HOST no está seteada, el código se loguea a consola en vez de
# enviarse (fallback de desarrollo, ver backend/src/services/emailService.ts).
# SMTP_HOST=smtp.ejemplo.com
# SMTP_PORT=587
# SMTP_USER=usuario@ejemplo.com
# SMTP_PASSWORD=
# SMTP_FROM=no-reply@contratos.local

# Identity (Sprint 1, T3): sesión JWT. JWT_SECRET es OBLIGATORIA (sin
# default: es un secreto) — el backend falla al arrancar si falta. Generar
# un valor propio, ej. `openssl rand -hex 32`; nunca reusar el de este
# archivo de ejemplo en un ambiente real.
JWT_SECRET=cambiar-por-un-secreto-real-y-largo
JWT_EXPIRES_MINUTES=60

# Fabric (T5): los defaults en src/config/fabric.ts ya sirven dentro de
# Docker (peer0.org1.example.com:7051, /crypto/...). Si corrés `npm run dev`
# fuera de Docker contra la red de T1 (network-up.sh) directamente en el
# host, necesitás overridear el endpoint del peer y la ruta al material
# criptográfico real (docker/fabric-samples/test-network/organizations/...):
# FABRIC_PEER_ENDPOINT=localhost:7051
# FABRIC_CRYPTO_PATH=../docker/fabric-samples/test-network/organizations/peerOrganizations/org1.example.com
