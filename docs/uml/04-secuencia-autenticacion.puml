@startuml 04-secuencia-autenticacion
actor Usuario
participant "Frontend\n(React)" as FE
participant "Backend\nAuth Controller" as BE
database "MongoDB" as DB
participant "Servicio de correo" as Mail

Usuario -> FE : Selecciona rol (RF-01)
Usuario -> FE : Ingresa usuario y contrasena (RF-02)
FE -> BE : POST /auth/login {usuario, password, rol}
BE -> DB : Validar credenciales (hash + salt) (RNF-01)
DB --> BE : Usuario valido
BE -> BE : Generar token de segundo factor (RF-03)
BE -> Mail : Enviar token al correo corporativo
Mail --> Usuario : Token de verificacion
BE --> FE : 200 OK (pendiente de 2FA)

Usuario -> FE : Ingresa token recibido
FE -> BE : POST /auth/verify-token {token}
BE -> BE : Validar token (RF-04)

alt credenciales, token y rol validos (RF-05)
    BE --> FE : 200 OK + sesion / JWT
    FE --> Usuario : Redireccion al panel segun rol (RF-06)
else credenciales o token invalidos
    BE --> FE : 401 Unauthorized
    FE --> Usuario : Mensaje de error claro (RNF-18)
end

...tiempo despues...
Usuario -> FE : Cerrar sesion (RF-07)
FE -> BE : POST /auth/logout
BE --> FE : Sesion invalidada (RNF-07)
@enduml
