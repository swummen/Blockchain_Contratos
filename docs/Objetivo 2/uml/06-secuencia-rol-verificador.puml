@startuml 06-secuencia-rol-verificador
actor Verificador
participant "Frontend" as FE
participant "Backend\nVerification Controller" as BE
participant "Hash Service\n(SHA-256)" as Hash
participant "Fabric Gateway\n(SDK)" as SDK
participant "Chaincode (Go)" as CC
database "MongoDB" as DB

== Consulta de la huella registrada ==
Verificador -> FE : Accede al modulo de verificacion (RF-023)
Verificador -> FE : Selecciona documento registrado (RF-024)
FE -> BE : GET /documentos/{id}
BE -> SDK : query ConsultarHuella(docId) (RF-025)
SDK -> CC : Consulta huella registrada

alt la huella existe en el ledger
    CC --> SDK : huellaRegistrada
    SDK --> BE : huellaRegistrada
    BE --> FE : 200 OK (huella visible solo a rol autorizado) (RF-026, RF-027)
else documento no encontrado
    CC --> SDK : no encontrada
    SDK --> BE : no encontrada
    BE --> FE : 404 Not Found
    FE --> Verificador : "Documento no registrado en la blockchain"
end

== Verificacion (cuando el documento existe) ==
Verificador -> FE : Carga documento a comparar (RF-028)
FE -> FE : Valida formato/tamano (RF-029)
FE -> BE : POST /verificaciones {docId, archivoComparar}
BE -> BE : Revalida formato y tamano del archivo (RF-029)
BE -> Hash : Generar huella del archivo cargado (RF-030)
Hash --> BE : huellaComparada
BE -> BE : Comparar huellaRegistrada vs huellaComparada (RF-031)

alt huellas coinciden
    BE -> BE : resultado = Verificado (RF-032)
else huellas difieren
    BE -> BE : resultado = Alterado (RF-032)
end

BE --> FE : huellaRegistrada, huellaComparada, resultado (RF-033)
BE -> SDK : invoke ActualizarEstado(docId, resultado)
SDK -> CC : Transaccion ActualizarEstado
CC --> SDK : txID
SDK --> BE : txID
BE -> DB : Actualizar estado del documento (RF-034)
BE -> SDK : invoke RegistrarEvento(docId, "Verificacion", usuario, resultado)
SDK -> CC : Transaccion RegistrarEvento
CC --> SDK : txID
SDK --> BE : confirmacion (RF-035)
BE --> FE : 200 OK
FE --> Verificador : Muestra resultado; opcion "Nueva verificacion" (RF-036)

== Consulta de documentos y trazabilidad general ==
Verificador -> FE : Consultar documentos registrados (RF-037)
FE -> BE : GET /documentos
BE -> DB : Buscar todos los documentos
DB --> BE : Lista completa (RF-038)
BE --> FE : 200 OK
FE --> Verificador : Tabla de documentos

Verificador -> FE : Consultar trazabilidad general (RF-039)
FE -> BE : GET /trazabilidad
BE -> SDK : query ConsultarTrazabilidad()
SDK -> CC : Consulta del historico completo
CC --> SDK : Eventos [Documento, Accion, Usuario, txID, Fecha, Resultado]
SDK --> BE : Eventos
BE --> FE : 200 OK (RF-040)
FE --> Verificador : Historial completo
@enduml
