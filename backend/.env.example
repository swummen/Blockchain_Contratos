# Copiar a backend/.env y ajustar. backend/.env nunca se versiona (.gitignore).

PORT=8080

# Dentro de docker/compose.app.yml, el backend alcanza a Mongo por su nombre
# de servicio en la red fabric_test:
MONGO_URI=mongodb://root:changeme@mongo:27017/?authSource=admin

# Si corrés `npm run dev` fuera de Docker (backend en el host, Mongo en el
# contenedor de T3 con el puerto publicado en 127.0.0.1), usa en cambio:
# MONGO_URI=mongodb://root:changeme@localhost:27017/?authSource=admin
