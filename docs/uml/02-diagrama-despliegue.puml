@startuml 02-diagrama-despliegue
skinparam node {
  BackgroundColor White
}

actor Usuario

node "Host Docker (docker-compose)" {

  node "Contenedor: frontend\n(Nginx + build de React)" as N_Front {
    component [SPA React] as App_Front
  }

  node "Contenedor: backend\n(Node.js + Express)" as N_Back {
    component [API REST] as App_Back
    component [Fabric SDK] as App_SDK
  }

  node "Contenedor: mongodb" as N_Mongo {
    database "MongoDB" as DB_Mongo
  }

  package "Red Hyperledger Fabric (contenedores Docker)" {
    node "Contenedor: ca.org1" as N_CA
    node "Contenedor: orderer.example.com" as N_Orderer
    node "Contenedor: peer0.org1" as N_Peer {
      component [Chaincode (Go)] as CC
      database "CouchDB\n(state database)" as CouchDB
    }
  }
}

Usuario --> App_Front : HTTPS (navegador)
App_Front --> App_Back : REST/JSON (HTTPS)
App_Back --> DB_Mongo : Driver MongoDB
App_Back --> App_SDK
App_SDK --> N_Peer : gRPC (invoke / query)
App_SDK --> N_Orderer : gRPC (envio de transacciones)
N_Peer --> CouchDB
N_CA --> N_Peer : emision de certificados (MSP)
N_CA --> N_Orderer : emision de certificados (MSP)

note bottom
  RNF-21: todos los componentes
  se ejecutan como contenedores
  Docker orquestados con
  Docker Compose (topologia
  de una sola organizacion,
  segun el alcance del MVP).
end note
@enduml
