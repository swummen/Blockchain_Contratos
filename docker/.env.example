# Copiar a docker/.env y ajustar. docker/.env nunca se versiona (.gitignore).

# --- Mongo (T3) ---
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=changeme
MONGO_PORT=27017

# --- Backend (T4) ---
# Puerto publicado en el host; adentro de fabric_test el backend siempre
# escucha en 8080. MONGO_URI se arma solo en compose.app.yml a partir de
# MONGO_ROOT_USER/MONGO_ROOT_PASSWORD de arriba.
BACKEND_PORT=8080

# --- Identity / JWT (Sprint 1, T3) ---
# Igual que MONGO_ROOT_PASSWORD arriba: valor de desarrollo, no usar en un
# ambiente real (backend/src/config/auth.ts no trae ningún default propio:
# lo exige justamente para no arrancar nunca con un secreto vacío; este de
# acá es el default explícito, versionado y documentado que compose.app.yml
# usa solo para que `docker/up.sh` funcione de una sin pasos extra).
JWT_SECRET=contratos-dev-secret-cambiar-en-produccion

# --- Correo del OTP (proveedor externo: Brevo) ---
# Vacío = el código se imprime en `docker logs backend` (modo desarrollo).
# Datos en Brevo: ⚙️ → SMTP & API → pestaña SMTP. SMTP_USER es el login
# xxxx@smtp-brevo.com (no tu correo); SMTP_PASSWORD es la SMTP key;
# SMTP_FROM tiene que ser un remitente verificado en Brevo.
# SMTP_HOST: usar smtp-relay.sendinblue.com (mismo servicio, nombre viejo de
# Brevo). Con smtp-relay.brevo.com, desde Colombia el relay que responde
# presenta un certificado solo para *.sendinblue.com y la conexión TLS falla
# ("Hostname/IP does not match certificate's altnames").
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Usuarios de prueba (los crea bash docker/up.sh al final) ---
# Con SEED_EMAIL=buzon@gmail.com se crean buzon+empleado@, buzon+empleado2@,
# buzon+verificador@ y buzon+admin@gmail.com: todos llegan al mismo buzón.
# Vacío = correos ficticios @empresa.com (el código solo se ve en los logs).
SEED_EMAIL=

# --- Frontend (T6) ---
# Puerto publicado en el host (nginx sirve el build de Vite en el puerto 80
# adentro del contenedor). VITE_API_URL es la URL que usa el NAVEGADOR (corre
# en el host), por eso es localhost:8080 y no backend:8080, Vite la bakea en
# el bundle en tiempo de build, así que un cambio acá requiere reconstruir la
# imagen (docker compose build frontend), no solo reiniciar el contenedor.
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:8080
