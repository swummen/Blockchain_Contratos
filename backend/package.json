{
  "name": "contratos-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Gateway Node.js + Express hacia Hyperledger Fabric y MongoDB (ver claude_docs/SPEC.md)",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx --env-file-if-exists=.env watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "seed": "tsx --env-file-if-exists=.env src/scripts/seedUsers.ts",
    "test": "jest",
    "lint": "oxlint src tests"
  },
  "engines": {
    "node": ">=22.9.0"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.4",
    "@hyperledger/fabric-gateway": "^1.12.1",
    "bcryptjs": "^2.4.3",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^6.11.0",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.10"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "oxlint": "^0.15.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
